# ---------------------------------------------------------------------------
# Hajer — environment
#
# Copy to .env.local for local dev (`pnpm dev:api` reads it). In production the
# waitlist Lambda reads the same names from SSM Parameter Store, one SecureString
# per variable under /hajer/<env>/landing/ (hajer repo, infra/README.md).
# Never commit real values.
#
# THE WAITLIST NEEDS A DESTINATION. With none configured in production,
# POST /api/waitlist returns 503 and the form tells the visitor their email was
# NOT recorded. It will never fake a confirmation.
#
# Resolution order: Supabase → signed webhook → local file.
# ---------------------------------------------------------------------------

# --- Supabase (the production destination) ---------------------------------
# Project → Settings → API. The URL is public; the service-role key is NOT.
SUPABASE_URL=https://nrvndlyughgagqhbkeqj.supabase.co

# SERVER ONLY. Bypasses row-level security. Never prefix this NEXT_PUBLIC_,
# never reference it from a client component. The waitlist table has RLS on
# with no policies, so this key is the only thing that can write to it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Alternative destinations (optional) -----------------------------------
# Used only when SUPABASE_* is absent. Provider-neutral signed webhook.
WAITLIST_WEBHOOK_URL=
WAITLIST_WEBHOOK_SECRET=

# Append-only JSONL. Outside production this defaults to .data/waitlist.jsonl
# even when unset, so local dev captures signups without any config.
WAITLIST_FILE_PATH=

# --- Founder follow-up via Google Workspace (optional) ----------------------
# Sent only after a bare waitlist signup has been durably recorded. The Gmail
# OAuth client needs the narrow gmail.send scope and a refresh token for the
# sending account. Keep every value server-only; never prefix with NEXT_PUBLIC_.
HAJER_GMAIL_CLIENT_ID=
HAJER_GMAIL_CLIENT_SECRET=
HAJER_GMAIL_REFRESH_TOKEN=
HAJER_GMAIL_FROM=omar@hajer.ai
HAJER_GMAIL_REPLY_TO=hello@hajer.ai

# PostHog needs no configuration here: the project token and EU host live in
# lib/posthog-config.ts (public by design, write-only).
